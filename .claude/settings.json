{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$env:PATH = [System.Environment]::GetEnvironmentVariable('PATH','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('PATH','User'); $root = git rev-parse --show-toplevel; if ($root) { Set-Location $root; git add .; git diff --cached --quiet; if ($LASTEXITCODE -ne 0) { git commit -m 'auto: atualizacao via Claude Code'; git push } }",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "Sincronizando com GitHub..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$g = \"$env:USERPROFILE\\.local\\bin\\graphify.EXE\"; if (Test-Path $g) { & $g hook-guard search }",
            "shell": "powershell"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "$g = \"$env:USERPROFILE\\.local\\bin\\graphify.EXE\"; if (Test-Path $g) { & $g hook-guard read }",
            "shell": "powershell"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  }
}